# PostgreSQL connection used by the Next.js server and CLI scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worldreborn

# Development admin credentials. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=$argon2id$...

# Optional absolute path to the retained legacy Aetheris tile directory.
# LEGACY_MAP_ROOT=/srv/worldreborn/map
